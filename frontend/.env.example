# Copy to .env.local.

# Where the Go API lives. Read on the server by every page; the browser never calls
# the API directly, so this stays inside the Next.js process.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Base of the shareable payment link shown in the detail panel. The platform does not
# host a payment page, so this is a placeholder made of the external reference.
NEXT_PUBLIC_PAYMENT_LINK_BASE=https://pay.example.com/r

# Shows the "simulate a received payment" control on a pending reference, which posts
# to /webhooks/payments. It only succeeds while the backend runs with WEBHOOK_SECRET
# empty. Set to false to hide it.
NEXT_PUBLIC_ENABLE_WEBHOOK_SIMULATOR=true
