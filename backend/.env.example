# Copy to .env and adjust. Every variable is read at startup and the process
# refuses to boot if a required one is missing or malformed.

# Required. PostgreSQL connection string.
DATABASE_URL=postgres://payment_links:payment_links@localhost:5432/payment_links?sslmode=disable

# HTTP port the API listens on.
PORT=8080

# Allowed browser origin for the dashboard. Comma-separated list, or * to allow
# any origin. Empty disables CORS entirely.
CORS_ORIGIN=http://localhost:3000

# Shared secret used to verify the HMAC-SHA256 signature of provider webhooks.
# Left empty, signature verification is skipped (handy for curl during review)
# and a warning is logged at startup.
WEBHOOK_SECRET=

# Observability and tuning. All optional.
LOG_LEVEL=info
LOG_FORMAT=json
DB_MAX_CONNS=10
DB_CONNECT_RETRY=10
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
