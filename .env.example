# Copy to .env and adjust. Every value has a working default, so `docker compose up
# --build` runs with no .env at all; this file exists to show what can be changed.

# --- Database -----------------------------------------------------------------
POSTGRES_USER=payment_links
POSTGRES_PASSWORD=payment_links
POSTGRES_DB=payment_links
# Host port. Change it if 5432 is already taken by a local PostgreSQL.
POSTGRES_PORT=5432

# --- API ----------------------------------------------------------------------
API_PORT=8080

# Browser origin allowed to call the API. A comma-separated list is accepted.
CORS_ORIGIN=http://localhost:3000

# Shared secret for verifying the HMAC-SHA256 signature of provider webhooks.
# LEFT EMPTY ON PURPOSE: with no secret the API accepts unsigned notifications, which
# is what lets `make webhook-demo` and the README curl examples work without signing
# anything. Set it to require signatures:
#   WEBHOOK_SECRET=un-secreto-largo
# and sign the body with:
#   printf '%s' "$BODY" | openssl dgst -sha256 -hmac "$WEBHOOK_SECRET" -hex
WEBHOOK_SECRET=

LOG_LEVEL=info
LOG_FORMAT=json

# --- Frontend -----------------------------------------------------------------
WEB_PORT=3000

# Base of the shareable payment link on the detail panel. The platform hosts no
# payment page, so this is a placeholder. Inlined at build time.
NEXT_PUBLIC_PAYMENT_LINK_BASE=https://pay.example.com/r

# Shows the "simulate a received payment" control on a pending reference. It posts to
# /webhooks/payments and only works while WEBHOOK_SECRET is empty.
NEXT_PUBLIC_ENABLE_WEBHOOK_SIMULATOR=true
